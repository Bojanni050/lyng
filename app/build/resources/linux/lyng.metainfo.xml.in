<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id><%= name %></id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0+</project_license>
  <name><%= productName %></name>
  <summary><%= description %></summary>
  <description>
    <p>
      Lyng is a local-first mail client built on the Mailspring codebase (GPL-3.0). It replaces
      the JavaScript sync code of Nylas Mail with a C++ sync engine based on Mailcore2, runs all
      of its features locally, and adds local AI features on top.
    </p>
    <p>
      Lyng comes packed with powerful features like Unified Inbox, Snooze, Send Later, Mail
      Rules, Templates and more. Pro favorites like link tracking, read receipts, mailbox
      analytics, contact and company profiles run without any account, because everything runs
      in the client - Lyng does not send your email credentials to the cloud.
    </p>
  </description>

  <url type="homepage">https://github.com/Bojanni050/lyng</url>
  <url type="bugtracker">https://github.com/Bojanni050/lyng/issues</url>
  <url type="contact">https://github.com/Bojanni050/lyng/issues</url>
  <url type="help">https://github.com/Bojanni050/lyng</url>
  <url type="contribute">https://github.com/Bojanni050/lyng/blob/main/CONTRIBUTING.md</url>
  <url type="vcs-browser">https://github.com/Bojanni050/lyng</url>

  <launchable type="desktop-id"><%= desktopName %></launchable>

  <developer id="io.github.bojanni050">
    <name>Lyng Team</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#d7f0f8</color>
    <color type="primary" scheme_preference="dark">#152330</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Lyng Hero</caption>
      <image type="source">https://github.com/Bojanni050/lyng/raw/main/screenshots/hero_graphic_mac@2x.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

