Windows Registry Editor Version 5.00

[{{HKEY_ROOT}}\SOFTWARE\Classes\Lyng.Url.mailto]
"FriendlyTypeName"="Lyng Url"

[{{HKEY_ROOT}}\SOFTWARE\Classes\Lyng.Url.mailto\shell]

[{{HKEY_ROOT}}\SOFTWARE\Classes\Lyng.Url.mailto\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Classes\Lyng.Url.mailto\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart Lyng.exe --process-start-args %1"


[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng]
@="Lyng"
"LocalizedString"="@{{PATH_TO_ROOT_FOLDER}}\\Update.exe,-123"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\DefaultIcon]
@="{{PATH_TO_APP_FOLDER}}\\Lyng.exe,1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Capabilities]
"ApplicationName"="Lyng"
"ApplicationDescription"="A fast, modern mail client designed to help you boost your productivity."

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Capabilities\StartMenu]
"Mail"="Lyng"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Capabilities\URLAssociations]
"mailto"="Lyng.Url.mailto"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Protocols]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Protocols\mailto]
@="URL:MailTo Protocol"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Protocols\mailto\DefaultIcon]
@="{{PATH_TO_APP_FOLDER}}\\Lyng.exe,1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Protocols\mailto\shell]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Protocols\mailto\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\Protocols\mailto\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart Lyng.exe --process-start-args %1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\shell]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\Lyng\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart Lyng.exe"

[{{HKEY_ROOT}}\SOFTWARE\RegisteredApplications]
"Lyng"="Software\\Clients\\Mail\\Lyng\\Capabilities"


[HKEY_CURRENT_USER\SOFTWARE\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache]
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe"="Lyng"
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe.FriendlyAppName"="Lyng"
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe.ApplicationCompany"="Lyng"
